{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../../lib/studio/**/*.ts"]
}
