# Field reference only. Never expose these to Vite clients.
# Prefer: npm run configure:inference -- /absolute/path/to/operator-document.md
# This imports inference-only fields into the private data directory, never this repository.
STUDIO_WEBSITE_ORIGIN=http://localhost:3001
STUDIO_PORT=4320
# Default: ~/Library/Application Support/Planeon/JourneyStudio (not cloud synchronized)
STUDIO_DATA_DIR=
# Generated private local secrets are used if empty. The transport secret must match the website server.
STUDIO_AUTH_SECRET=
STUDIO_TRANSPORT_SECRET=
# Optional explicit overrides. Leave these UNSET when using an imported private profile.
# Empty environment overrides intentionally disable the profile (do not source this blank template).
# Dedicated Planeon bearer key only; approved self-hosted model with fallback disabled at the engine.
STUDIO_INFERENCE_URL=
STUDIO_INFERENCE_KEY=
STUDIO_INFERENCE_MODEL=
STUDIO_INFERENCE_IDENTITY=planeon-ai-web-site
STUDIO_SELF_HOSTED_APPROVAL=
# Real mail is off by default. Activation requires a verified, reserved no-cost allowance.
STUDIO_MAIL_ENABLED=false
STUDIO_MAIL_FREE_PLAN_VERIFIED=false
STUDIO_RESEND_API_KEY=
# UTC day of the verified allowance; expires at midnight, deliberately fail-closed.
STUDIO_MAIL_BUDGET_DAY=
STUDIO_MAIL_DAILY_BUDGET=0
STUDIO_MAIL_MONTHLY_BUDGET=0
STUDIO_ATTACHMENT_LIMIT=5000000
